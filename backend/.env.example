# =============================================================================
# AI Production Incident Response Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# --- LLM Providers ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_DEFAULT_REPO=owner/repo-name

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incidents

# --- Supabase (alternative to self-hosted PostgreSQL) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# --- Slack Integration ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
